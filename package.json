{
  "name": "ai-powered-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-ort-binary.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:smoke": "node --env-file=.env.local scripts/db-smoke.mjs",
    "cleanup:orphans": "node --env-file=.env.local scripts/cleanup-orphans.mjs",
    "verify:repos": "tsx scripts/verify-repositories.ts",
    "verify:reliability": "tsx scripts/verify-reliability.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:demo": "tsx scripts/eval-demo.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@huggingface/transformers": "^4.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.5",
    "onnxruntime-node": "1.30.0",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
